# Core database/runtime (Compose defaults to the local dotmac-db service)
APP_ENV=production
SERVER_NAME=dotmac-sub-prod
APP_URL=https://selfcare.dotmac.io
DATABASE_URL=postgresql+psycopg://postgres:change-me@dotmac-db:5432/dotmac_sub
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
POSTGRES_PASSWORD=change-me
# Fresh installs: generate this key once. Upgrades: keep the exact existing key;
# replacing it makes every existing enc: value undecryptable.
CREDENTIAL_ENCRYPTION_KEY=generate-with-make-generate-encryption-key
# One-time OpenBao bootstrap input. Set this to the exact same value as
# CREDENTIAL_ENCRYPTION_KEY, never a newly generated upgrade key. Remove it after
# scripts/setup/openbao_init.sh, then point CREDENTIAL_ENCRYPTION_KEY at the
# managed reference below for scheduled rotation.
# CREDENTIAL_ENCRYPTION_KEY=bao://secret/settings/auth#credential_encryption_key
CREDENTIAL_ENCRYPTION_KEY_SEED=
CREDENTIAL_ROTATION_ENABLED=true
CREDENTIAL_ROTATION_AUTO_APPLY=true
CREDENTIAL_ROTATION_INTERVAL_DAYS=90
CREDENTIAL_ROTATION_GRACE_DAYS=7

# Database pool limits are per process. The default is sized for the current
# production shape: 4 Uvicorn workers plus 10 Celery prefork children against a
# ~100-connection Postgres. Keep these conservative unless PgBouncer is in front
# of Postgres or max_connections has been deliberately resized.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT=20
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=120000
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=60000
WEB_THREADPOOL_LIMIT=6

# Admin dashboard caching. Production defaults preserve synchronous refreshes.
# In staging, prewarming plus stale-while-revalidate keeps intentionally absent
# integrations and expensive overview aggregates off the sign-in request path.
DASHBOARD_PREWARM_ENABLED=false
DASHBOARD_GLOBAL_CACHE_TTL_SECONDS=60
DASHBOARD_GLOBAL_STALE_WHILE_REVALIDATE=false
DASHBOARD_GLOBAL_MAX_STALE_SECONDS=900
DASHBOARD_INFRASTRUCTURE_CACHE_TTL_SECONDS=60
# Comma-separated probe keys: postgres, redis, victoriametrics, genieacs,
# radius_db, minio, celery, nominatim. Leave empty unless a dependency is
# intentionally absent in this environment.
INFRASTRUCTURE_HEALTH_SKIP_CHECKS=

# Shared Redis/cache
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis-host:6379/0
SESSION_REDIS_URL=redis://:change-me@redis-host:6379/0
# How stale a cached setting may be when an invalidation does not land.
# Invalidation is explicit (one after_commit listener on DomainSetting);
# this bounds being wrong when it misses. 30 matches the retired cache.
SETTINGS_CACHE_TTL_SECONDS=30
CELERY_BROKER_URL=redis://:change-me@redis-host:6379/0
CELERY_RESULT_BACKEND=redis://:change-me@redis-host:6379/1

# Shared private S3-compatible object storage
S3_ENDPOINT_URL=http://s3-host:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_NAME=dotmac-private
S3_REGION=us-east-1

# Migration scripts (SmartOLT) — only needed during migration
# SMARTOLT_API_KEY=your-smartolt-api-key
# GENIEACS_NBI_URL=http://localhost:7557

# Shared observability/secrets
GLITCHTIP_DSN=http://project-dsn@observability-host:8000/1
GLITCHTIP_ENABLED=true
OPENBAO_ADDR=http://observability-host:8200
OPENBAO_TOKEN=change-me
# Prefer a mounted token file over OPENBAO_TOKEN when the deployment supports it.
# OPENBAO_TOKEN_FILE=/run/secrets/openbao_token
OPENBAO_CACHE_TTL_SECONDS=60
# Public verification key only. The audit exporter's private signing key must
# live under a separate OpenBao path and ACL unavailable to this application.
#
# RETIRED as a runtime variable: the anchor is no longer a settings row holding
# a reference, because that guard checked the value WAS a reference and never
# WHICH one — anyone able to write settings could aim it at their own key. It is
# now held from a path fixed in code. Set the PEM below and run
# `scripts/setup/openbao_init.sh`, which seeds
# `secret/settings/billing#prepaid_reconstruction_attestation_public_key`.
# PREPAID_RECONSTRUCTION_ATTESTATION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----…"

# The settings-encryption keyring, in the shape the kernel's
# SETTINGS_ENCRYPTION_KEYS variable accepts. Bootstrap input only: it is seeded
# into `secret/settings/crypto#settings_encryption_keyring` and read from there.
#
# `key_id` must stay stable for the life of its material — it is written into
# every value the key encrypts, and remapping one makes those values unreadable.
# Rotation ADDS an entry and marks the old one "retired"; it never edits in
# place. To supply managed material instead of generating it, use the shape
# below with a key produced by `Fernet.generate_key()`.
# SETTINGS_ENCRYPTION_KEYRING=[{"key_id":"k1","key":"…","status":"active"}]
LOKI_URL=http://observability-host:3100

# --- added 2026-04-16 — compose no longer provides defaults for these; fail-fast required ---
# FreeRADIUS SQL is intentionally separate from the app DATABASE_URL. On an
# upgrade, seed these from the existing active FreeRADIUS connector target.
FREERADIUS_DB_HOST=radius-db
FREERADIUS_DB_PORT=5432
FREERADIUS_DB_NAME=radius
FREERADIUS_DB_USER=radius
FREERADIUS_DB_PASS=change-me-generate-with-openssl-rand-base64-24
RADIUS_ACCOUNTING_SOURCE_STALE_SECONDS=3600
# Shared secret for the admin-login (device-login) RADIUS realm on 1822/1823.
# Must match each router's `/radius service=login` secret. Generate with openssl.
ADMIN_RADIUS_SECRET=change-me-generate-with-openssl-rand-hex-24
GENIEACS_MONGODB_PASSWORD=change-me-generate-with-openssl-rand-base64-24
GENIEACS_UI_JWT_SECRET=change-me-generate-with-openssl-rand-base64-24
TR069_AUTH_SHARED_SECRET=change-me-generate-with-openssl-rand-base64-32
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-generate-with-openssl-rand-base64-24

# Pre-database API pressure guard. The service lane only applies to GET sync
# feeds and exact subscriber/billing-account detail routes, and still requires
# normal API-key authorization downstream. Keep the IP list restricted to the
# ERP egress address; comma-separate values when rotating hosts.
API_SYNC_PRESSURE_SERVICE_CLIENTS=dotmac-erp
API_SYNC_PRESSURE_SERVICE_IPS=149.102.158.167
API_SYNC_PRESSURE_SERVICE_LIMIT=300

# Native Team Inbox live chat. See docs/CHAT_LIVE_SETUP.md.
CHAT_LIVE_ENABLED=false
FIBER_CHAT_ALLOWED_ORIGIN=https://fiber.dotmac.ng

# Default-off Team Inbox voice transcription bootstrap. Complete the provider
# review in docs/runbooks/VOICE_TRANSCRIPTION.md before enabling. Keep the API
# key empty here; seed the stored setting with an OpenBao reference, never a
# literal secret.
VOICE_TRANSCRIPTION_BASE_URL=
VOICE_TRANSCRIPTION_MODEL=
VOICE_TRANSCRIPTION_API_KEY=
VOICE_TRANSCRIPTION_TIMEOUT_SECONDS=
VOICE_TRANSCRIPTION_MAX_RETRIES=
VOICE_TRANSCRIPTION_ENABLED=false
INTELLIGENCE_INBOX_ANALYST_ENABLED=false

# Team-inbox email intake. The SMTP listener is an opt-in, single-instance
# compose profile; configure these values, then run `make prod-smtp-inbound-up`.
# A host MTA should relay only the listed recipients to the loopback publish port.
# With a probe recipient configured, the runtime continuously proves SMTP-to-inbox
# delivery. Keep its interval below the email contract's synthetic maximum age.
TEAM_INBOX_SMTP_INBOUND_RECIPIENTS=
TEAM_INBOX_SMTP_FALLBACK_SERVICE_TEAM_ID=
TEAM_INBOX_SMTP_PROBE_RECIPIENT=
TEAM_INBOX_SMTP_PROBE_INTERVAL_SECONDS=900
TEAM_INBOX_SMTP_PROBE_TIMEOUT_SECONDS=120
TEAM_INBOX_SMTP_INBOUND_PUBLISH_PORT=2525
TEAM_INBOX_SMTP_LOG_LEVEL=INFO

# Router config snapshots via SSH /export (RouterOS 7.x REST can't return config
# text). Uses the dedicated dotmac-ops SSH key (not the API/REST identity).
# Place the key on the host at ./secrets/dotmac-ops.key (mounted into celery-worker).
ROUTER_CONFIG_EXPORT_VIA_SSH=true
ROUTER_CONFIG_SSH_USERNAME=dotmac-ops
ROUTER_CONFIG_SSH_PORT=120
ROUTER_CONFIG_SSH_KEY_PATH=/etc/dotmac/dotmac-ops.key
ROUTER_CONFIG_SSH_KNOWN_HOSTS_PATH=/etc/dotmac/router_known_hosts
ROUTER_CONFIG_SSH_STRICT_HOST_KEY=false

# Synthetic RADIUS auth probe (radius_health). Unset = probe disabled.
# Generate: openssl rand -base64 24
RADIUS_PROBE_SECRET=
RADIUS_PROBE_PASSWORD=
# Worker source range FreeRADIUS accepts the probe from (compose bridge).
RADIUS_PROBE_CLIENT_SUBNET=172.20.0.0/16

# Subnet for the compose bridge the app/workers run on (docker-compose.yml).
# Leave unset unless this host runs more than one Dotmac stack: dotmac_crm's
# compose also claims 172.20.255.0/24, so co-hosting sub + CRM collides, and
# `docker compose up` will try to tear down and recreate the network -- which
# disconnects the DB (compose treats it as an orphan and does NOT reattach it)
# and any sibling stack's containers sharing the bridge.
#
# MUST stay inside RADIUS_PROBE_CLIENT_SUBNET above. Moving the containers out of
# that range does not error -- FreeRADIUS just silently stops accepting their
# probe requests.
#
#   DOCKER_SUBNET=172.20.254.0/24

# Keep this equal to DOCKER_SUBNET when overriding the compose bridge so VPN
# route installation cannot expose the host-management bridge to subscribers.
VPN_BLOCKED_LAN_SUBNETS=172.20.255.0/24

# VictoriaMetrics port binding prefix. Unset (default) binds 8428 to
# 127.0.0.1 only. Prod sets VM_BIND=0.0.0.0: so the central observability
# host can federate/scrape it; exposure is source-restricted to the observe
# IP by the host firewall (DOCKER-USER rule), not left open to the internet.
# VM_BIND=0.0.0.0:

# Postgres (dotmac_pg_local) port binding prefix. Unset (default) binds 9001 to
# 127.0.0.1 only. Prod sets PG_LOCAL_BIND=0.0.0.0: because the replication
# standby streams through this published port from off-host, so loopback-only
# is not an option here; exposure is source-restricted to the standby IP by the
# host firewall (DOCKER-USER rule), not left open to the internet.
#
# Do NOT revert this to a bare "9001:5432". A publish with no host address is
# dual-family: Docker also listens on [::], and IPv6 published traffic is
# served by a userland docker-proxy that terminates on INPUT rather than
# traversing FORWARD, so it never reaches DOCKER-USER and no rule in that chain
# can restrict it. Naming an IPv4 host address removes the [::] listener.
#
# Changing this value does NOT take effect by deploying. postgres-local is not
# in deploy.sh's APP_SERVICES, so a deploy never recreates that container and
# it keeps whatever binding it was created with. Applying a change here is a
# deliberate, separately scheduled recreate of postgres-local -- which briefly
# interrupts every database connection, so treat it as a maintenance action and
# not a side effect of a release.
# PG_LOCAL_BIND=0.0.0.0:

# Every remaining published-port bind prefix. Declared intent for all of them
# lives in deploy/published_ports.toml, and two checks hold it: an offline
# compose check in CI, and a check that reads the host's ACTUAL listeners in
# both address families (scripts/published_ports.py check-listeners).
#
# The rule is default-deny by shape: a publish always names an address. A bare
# "514:514/udp" is not "IPv4" -- Docker publishes on 0.0.0.0 AND [::], and the
# [::] half traverses no DOCKER-USER rule. Loopback is the default wherever the
# service has no off-host client; the two collectors below take an explicit
# IPv4 wildcard instead, because the devices that talk to them are off-host by
# definition. Explicit is the point, not narrow.
#
# Applying a change to any of these is a deliberate, recorded operation --
# `scripts/reconcile_published_ports.sh`, or the "Reconcile infrastructure
# published ports" workflow -- because a deploy does not recreate these
# containers. The one exception is SYSLOG_BIND: syslog-listener IS in
# deploy.sh's APP_SERVICES, so a change to its bind rides the next release.
# APP_BIND=127.0.0.1:
# NOMINATIM_BIND=127.0.0.1:
# GENIEACS_MONGODB_BIND=127.0.0.1:
# TEAM_INBOX_SMTP_BIND=127.0.0.1:
# FREERADIUS_BIND=0.0.0.0:
# SYSLOG_BIND=0.0.0.0:

# ---------------------------------------------------------------------------
# Field-mobile OIDC federation (docs/designs/OIDC_MOBILE_FEDERATION.md)
#
# These are BOOTSTRAP inputs: the settings seed materialises them into
# `domain_settings` rows once, and runtime resolution reads the rows, never the
# environment. Every identifier below is non-inheriting — a platform row must
# not stand in for a missing tenant row, because a less-specific answer to
# "which issuer" names the WRONG identity rather than a weaker one.
#
# The mechanism is OFF by default (control `auth.oidc_mobile_federation`).
# Leave these unset until it is turned on; once it is, the boot preflight
# refuses to start with any of them missing.
#
# There is deliberately NO client secret: a public mobile client has nowhere to
# keep one, and PKCE (S256, enforced at ceremony start) is the proof of
# possession.
#
# OIDC_MOBILE_ISSUER=
# OIDC_MOBILE_CLIENT_ID=
# The permanent, fleet-owned callback. Not derived from this deployment's
# hostname, and compared for EXACT equality at exchange.
# OIDC_MOBILE_REDIRECT_URI=
# The mobile application's identity, which is not the OAuth client id.
# OIDC_MOBILE_AUDIENCE=
# Which installed `authentication_bindings` row (mechanism `oidc`) answers.
# OIDC_MOBILE_BINDING_KEY=
# OIDC_MOBILE_DEPLOYMENT_ID=

# Signing-key policy. `discovery` derives the JWKS URI from the issuer's
# well-known document; `static_uri` uses OIDC_MOBILE_JWKS_URI verbatim and
# contacts no discovery endpoint.
# OIDC_MOBILE_JWKS_SOURCE=discovery
# OIDC_MOBILE_JWKS_URI=
# The bound on refresh: an unknown key id triggers AT MOST one fetch, and only
# this long after the previous ATTEMPT — so an unknown-kid flood cannot
# amplify into per-request traffic to the identity provider.
# OIDC_MOBILE_JWKS_MIN_REFRESH_SECONDS=300
# OIDC_MOBILE_JWKS_TIMEOUT_SECONDS=5

# OIDC_MOBILE_CEREMONY_TTL_SECONDS=300
# OIDC_MOBILE_CLOCK_SKEW_SECONDS=60
# `exp` is the identity provider's opinion of freshness; this is Sub's.
# OIDC_MOBILE_MAX_ASSERTION_AGE_SECONDS=300
